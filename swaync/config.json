{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "ignore-gtk-theme": true,
  "positionX": "right",
  "positionY": "top",
  "layer": "overlay",
  "control-center-layer": "top",
  "layer-shell": true,
  "layer-shell-cover-screen": false,
  "cssPriority": "user",
  "control-center-margin-top": 10,
  "control-center-margin-bottom": 0,
  "control-center-margin-right": 10,
  "control-center-margin-left": 0,
  "notification-2fa-action": true,
  "notification-inline-replies": false,
  "notification-body-image-height": 100,
  "notification-body-image-width": 200,
  "timeout": 6,
  "timeout-low": 3,
  "timeout-critical": 0,
  "fit-to-screen": false,
  "relative-timestamps": true,
  "control-center-width": 420,
  "control-center-height": 680,
  "notification-window-width": 380,
  "keyboard-shortcuts": true,
  "notification-grouping": true,
  "image-visibility": "when-available",
  "transition-time": 200,
  "hide-on-clear": false,
  "hide-on-action": true,
  "text-empty": "No Notifications",
  "script-fail-notify": true,
  "widgets": [
    "title",
    "dnd",
    "mpris",
    "buttons-grid",
    "volume",
    "backlight",
    "notifications"
  ],
  "widget-config": {
    "notifications": {
      "vexpand": true
    },
    "title": {
      "text": "Notifications",
      "clear-all-button": true,
      "button-text": "Clear All"
    },
    "dnd": {
      "text": "Do Not Disturb"
    },
    "mpris": {
      "blacklist": [],
      "autohide": false,
      "show-album-art": "always",
      "loop-carousel": false
    },
    "volume": {
      "label": "󰓃"
    },
    "backlight": {
      "label": "󰃞"
    },
    "buttons-grid": {
      "buttons-per-row": 5,
      "actions": [
        {
          "label": "󰖩",
          "type": "toggle",
          "active": true,
          "command": "sh -c '[[ $SWAYNC_TOGGLE_STATE == true ]] && nmcli radio wifi on || nmcli radio wifi off'",
          "update-command": "sh -c '[[ $(nmcli radio wifi) == \"enabled\" ]] && echo true || echo false'"
        },
        {
          "label": "󰂯",
          "type": "toggle",
          "active": true,
          "command": "sh -c '$HOME/.config/swaync/scripts/bt-toggle.sh'",
          "update-command": "sh -c '$HOME/.config/swaync/scripts/bt-status.sh'"
        },
        {
          "label": "",
          "type": "normal",
          "command": "hyprlock"
        },
        {
          "label": "󰐥",
          "type": "normal",
          "command": "systemctl poweroff"
        },
        {
          "label": "󰹑",
          "type": "normal",
          "command": "sh -c '$HOME/.config/swaync/scripts/screenshot-area.sh'"
        },
        {
          "label": "󰄀",
          "type": "normal",
          "command": "sh -c '$HOME/.config/swaync/scripts/screenshot-full.sh'"
        },
        {
          "label": "",
          "type": "toggle",
          "active": false,
          "command": "sh -c '$HOME/.config/swaync/scripts/record-toggle.sh'",
          "update-command": "sh -c '[ -f /tmp/wf-recorder.pid ] && echo true || echo false'"
        },
        {
          "label": "󰖠",
          "type": "normal",
          "command": "sh -c '$HOME/.config/swaync/scripts/webcam-shot.sh'"
        },
        {
          "label": "󰛨",
          "type": "normal",
          "command": "sh -c '$HOME/.config/waybar/scripts/shader-picker.sh'"
        },
        {
          "label": "󰀝",
          "type": "toggle",
          "active": false,
          "command": "sh -c '$HOME/.config/swaync/scripts/airplane-toggle.sh'",
          "update-command": "sh -c '$HOME/.config/swaync/scripts/airplane-status.sh'"
        },
        {
          "label": "󰍎",
          "type": "toggle",
          "active": true,
          "command": "sh -c '$HOME/.config/swaync/scripts/location-toggle.sh'",
          "update-command": "sh -c '$HOME/.config/swaync/scripts/location-status.sh'"
        }
      ]
    }
  }
}